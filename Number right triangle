import java.util.*;
 public class main {
     public static void main(String[]args)
     {
         Scanner s=new Scanner(System.in);
         int i,j;
         int count;
         int d=s.nextInt();
         for (i=1;i<=d;i++){
            count=0;
            for(j=1;j<=i;j++)
            {
             
              count++;
            System.out.print(count);
            }
            
            System.out.println();
         }
     }
 }
