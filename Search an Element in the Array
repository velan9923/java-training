import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);

        int n = s.nextInt();
        int[] a = new int[50];
        int count = 0;

        for(int i = 0; i < n; i++) {
            a[i] = s.nextInt();
        }

        int m = s.nextInt();  

        for(int i = 0; i < n; i++) {
            if(a[i] == m) {
                count++;
            }
        }

        if(count >= 1) {
            System.out.println("Found");
        } else {
            System.out.println("Not Found");
        }
    }
}
