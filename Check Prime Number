import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        int i;
        int count=0;
        Scanner s=new Scanner(System.in);
        int a=s.nextInt();
        for(i=1;i<=a;i++)
        { 
            if(a%i==0)
            {
                count++;
            }
           
        }
        if(count==2)
        {
            System.out.println("Prime");
        }
        else
            {
            System.out.println("Not Prime");
        }
            
    }
}
