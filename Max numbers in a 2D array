import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner s=new Scanner(System.in);
        int m=s.nextInt();
        int n=s.nextInt();
        int a[][]=new int[50][50];
        
        for(int i=0;i<m;i++){
            for(int j=0;j<n;j++){
           a [i][j]=s.nextInt();
            }
        }
            int max=a[0][0];
           for(int i=0;i<m;i++){
            for(int j=0;j<n;j++){
                if(max<a[i][j]){
                    max=a[i][j];
                }
            }
           }
   System.out.println(max);
        }
         
           }
  
