import java.util.*;
class Main {
    public static void main(String[] args) {
        
        Scanner s=new Scanner(System.in);
  
        int n=s.nextInt();
        int prod=1;
       while(n>0)
       {
        int d=n%10;
        prod=prod*d;
        n=n/10;

       }
       
       System.out.println(prod);
        
    }
}
