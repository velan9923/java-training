import java.util.*;

public class Solution {

    public static void main(String[] args) {
      Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int reverse =0;
        int original=n;
        while (n>0){
            int d = n%10;
            reverse=reverse*10+d;
            n=n/10;
        }
        if(original==reverse)
            System.out.println("Palindrome");
            else
                System.out.println("Not Palindrome");
    }
}
